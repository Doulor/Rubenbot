{
  "id": "music",
  "name": "点歌",
  "version": "1.1.0",
  "description": "「点歌 <歌名>」「我想听 <歌名>」搜网易云，默认发歌名 + 链接 + 封面图；可选 OneBot 音乐卡片",
  "author": "RubenBot",
  "min_core_version": "0.1.0",
  "permissions": ["read_messages", "send_messages", "network"],
  "config_schema": [
    {
      "key": "triggers",
      "type": "list",
      "default": ["点歌", "我想听"],
      "description": "点歌触发词，消息以其中之一开头即触发"
    },
    {
      "key": "cooldown_seconds",
      "type": "number",
      "default": 60,
      "description": "单人两次点歌之间的冷却秒数"
    },
    {
      "key": "source",
      "type": "string",
      "default": "netease",
      "description": "默认音源（目前只支持 netease）"
    },
    {
      "key": "music_card",
      "type": "boolean",
      "default": false,
      "description": "是否先尝试 OneBot 音乐卡片（默认关闭：新版 QQ 不渲染，只显示「发送者版本过低」）"
    }
  ],
  "hooks": ["on_message", "on_stop"],
  "category": "工具",
  "icon": "🎵"
}
