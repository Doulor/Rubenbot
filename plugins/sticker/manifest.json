{
  "id": "sticker",
  "name": "表情包",
  "version": "1.0.0",
  "description": "收集群里出现的表情入库，在合适的时机回一张，只经能力层发送",
  "author": "RubenBot",
  "min_core_version": "0.1.0",
  "permissions": ["read_messages", "send_messages", "capabilities"],
  "config_schema": [
    {
      "key": "collect",
      "type": "bool",
      "default": false,
      "description": "收集群聊里的表情 / 图片入库（默认关：表情是别人的东西，要先显式打开）"
    },
    {
      "key": "send_probability",
      "type": "float",
      "default": 0.15,
      "description": "bot 每完成一轮回复后补一张表情的概率（0–1，默认 0.15，偏保守）"
    },
    {
      "key": "cooldown_seconds",
      "type": "int",
      "default": 300,
      "description": "同一会话两次发表情的最小间隔（秒，默认 300）"
    }
  ],
  "hooks": ["on_message", "on_after_reply"],
  "category": "互动",
  "icon": "🖼️"
}
