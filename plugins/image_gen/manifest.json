{
  "id": "image_gen",
  "name": "画图",
  "version": "1.1.0",
  "description": "「画一张 <描述>」调用 OpenAI 兼容生图端点（硅基流动为预设示例），下载图片后以图片段发送；带冷却、每日上限与本地黑名单",
  "author": "RubenBot",
  "min_core_version": "0.1.0",
  "permissions": ["read_messages", "send_messages", "network"],
  "config_schema": [
    {
      "key": "base_url",
      "type": "string",
      "default": "",
      "description": "生图端点根地址（OpenAI 兼容，如 https://api.siliconflow.cn/v1），不带结尾斜杠"
    },
    {
      "key": "api_key",
      "type": "string",
      "default": "",
      "description": "端点密钥，支持 ${ENV_VAR} 占位"
    },
    {
      "key": "model",
      "type": "string",
      "default": "",
      "description": "生图模型名（如 Kwai-Kolors/Kolors）；base_url / api_key / model 齐全才注册触发"
    },
    {
      "key": "size",
      "type": "string",
      "default": "1024x1024",
      "description": "出图尺寸，原样作为 size 传给端点"
    },
    {
      "key": "triggers",
      "type": "list",
      "default": ["画一张", "画个", "画一幅", "帮我画", "生成图片"],
      "description": "触发词，消息以其中之一开头即触发"
    },
    {
      "key": "cooldown_seconds",
      "type": "number",
      "default": 120,
      "description": "单人两次画图之间的冷却秒数"
    },
    {
      "key": "daily_limit",
      "type": "number",
      "default": 20,
      "description": "每个会话每天最多生成几张（0 = 不限）"
    },
    {
      "key": "blacklist",
      "type": "list",
      "default": ["儿童色情", "幼女", "恋童", "血腥", "分尸", "虐杀"],
      "description": "本地关键词黑名单，描述命中就拒绝；留空表示只用服务商审核"
    }
  ],
  "hooks": ["on_message", "on_stop"],
  "category": "工具",
  "icon": "🎨"
}
